# PostgreSQL
POSTGRES_USER=aura
POSTGRES_PASSWORD=aura_password
POSTGRES_DB=aura_db

# Backend
# Optional: if left blank, AURA automatically uses realistic demo data instead
# of a live provider, and clearly labels responses as DEMO DATA.
OPENWEATHER_API_KEY=
AURA_DEFAULT_LAT=28.4744
AURA_DEFAULT_LON=77.5040

# Frontend
VITE_API_URL=http://localhost:8000
